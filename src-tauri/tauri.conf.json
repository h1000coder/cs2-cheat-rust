{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "freeadom-cs2",
  "version": "0.1.0",
  "identifier": "com.hmqax.freeadom-cs2",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "freeadom-cs2",
        "width": 800,
        "height": 600,
        "shadow": true,
        "alwaysOnTop": true,
        "minimizable": false,
        "maximizable": false,
        "resizable": false,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
